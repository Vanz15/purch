# --- LLM (do not rename; llm/groq_client.py reads GROQ_API_KEY exactly) ---
GROQ_API_KEY=

# Optional Gemini key if llm/tone.py or wallet_llm.py expects GEMINI_API_KEY
# (grep OLD/llm + purch/wallet_llm.py to confirm; add if present)
# GEMINI_API_KEY=

# --- Database ---
